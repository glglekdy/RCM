{
  "name": "rcm",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm -w @rcm/editor run dev",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/playfield && npm -w @rcm/editor run typecheck",
    "dist": "npm -w @rcm/editor run dist",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
